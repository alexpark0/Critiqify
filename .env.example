# Gemini API key
# 1. Create a key at https://aistudio.google.com/apikey
# 2. Copy this file to .env
# 3. Paste the key as VITE_API_KEY
# 4. Restart `npm run dev`
#
# Never commit .env or a real key. Critiqify reads the key from
# import.meta.env.VITE_API_KEY.
VITE_API_KEY=

# Optional. Set to true to preview critique and chat without calling Gemini.
# Leave this unset when VITE_API_KEY is a real key. If both are set, mock mode wins.
# VITE_MOCK_GEMINI=true
